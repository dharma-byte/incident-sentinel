# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/incident_sentinel
REDIS_URL=redis://localhost:6379/0
GROQ_API_KEY=                            # free tier key from console.groq.com (deploy only)
OLLAMA_BASE_URL=http://localhost:11434   # fallback local LLM
LLM_PROVIDER=ollama                      # groq | ollama  (ollama by default for local dev)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Tests use this database (created automatically); keep it separate from dev data.
TEST_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/incident_sentinel_test
